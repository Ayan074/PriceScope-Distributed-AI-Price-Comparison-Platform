# ─── PriceScope Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values

# SerpAPI key (free tier: 100 searches/month)
# Used by: Google Shopping service, Walmart service (fallback)
# Get yours at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Redis URL (required for Celery task queue, optional for caching)
# If Redis is not available, the system falls back to async parallel mode
# with in-memory caching
REDIS_URL=redis://localhost:6379

# OpenAI API key (optional — enables LLM-powered analysis via MCP)
# If not set, the system uses rule-based analysis (works great without it)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Cache TTL in seconds (default: 5 minutes)
CACHE_TTL_SECONDS=300

# Set to false to disable Celery and always use async parallel mode
USE_CELERY=true

# Gateway port
GATEWAY_PORT=8000
DEBUG=true
